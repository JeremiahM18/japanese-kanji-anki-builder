{
  "noteTypeName": "Japanese Kanji Builder",
  "cardTemplateName": "Recognition",
  "fieldNames": [
    "Kanji",
    "DisplayWord",
    "MeaningJP",
    "PrimaryReading",
    "StudyWordKanji",
    "OnReading",
    "KunReading",
    "StrokeOrder",
    "StrokeOrderImage",
    "StrokeOrderAnimation",
    "Audio",
    "Radical",
    "Notes",
    "ExampleSentence"
  ],
  "cssLines": [
    ".card {",
    "  font-family: \"Yu Gothic UI\", \"Hiragino Sans\", sans-serif;",
    "  font-size: 20px;",
    "  text-align: center;",
    "  color: #1f2933;",
    "  background: #f7f3ea;",
    "}",
    ".study-word {",
    "  font-size: 56px;",
    "  margin: 16px 0 8px;",
    "}",
    ".kanji-core {",
    "  font-size: 16px;",
    "  color: #52606d;",
    "  letter-spacing: 0.04em;",
    "}",
    ".reading-primary {",
    "  font-size: 30px;",
    "  font-weight: 700;",
    "  color: #111827;",
    "}",
    ".field-label {",
    "  display: block;",
    "  font-size: 14px;",
    "  font-weight: 700;",
    "  color: #3f4c5a;",
    "}",
    ".study-word-kanji {",
    "  font-size: 15px;",
    "  color: #52606d;",
    "}",
    ".kanji-level-badge {",
    "  display: inline-block;",
    "  margin: 2px 4px;",
    "  padding: 2px 6px;",
    "  border: 1px solid #d0d7de;",
    "  border-radius: 6px;",
    "  background: #ffffff;",
    "}",
    ".reading-full {",
    "  font-size: 19px;",
    "  color: #334155;",
    "}",
    ".reading, .meaning, .meta, .notes, .example, .media, .audio {",
    "  margin: 12px 0;",
    "  line-height: 1.5;",
    "}",
    ".media img {",
    "  max-width: 280px;",
    "  height: auto;",
    "}",
    ".nightMode .field-label, .night_mode .field-label {",
    "  color: #d1d5db;",
    "}",
    ".nightMode .reading-primary, .night_mode .reading-primary {",
    "  color: #f9fafb;",
    "}",
    ".nightMode .reading-full, .night_mode .reading-full {",
    "  color: #e5e7eb;",
    "}"
  ],
  "qfmt": "<div class=\"study-word\">{{Kanji}}</div>",
  "afmtLines": [
    "{{FrontSide}}",
    "<hr id=\"answer\">",
    "{{#PrimaryReading}}<div class=\"reading reading-primary\"><span class=\"field-label\">Primary reading</span>{{PrimaryReading}} - {{MeaningJP}}</div>{{/PrimaryReading}}",
    "{{^PrimaryReading}}<div class=\"meaning\">{{MeaningJP}}</div>{{/PrimaryReading}}",
    "{{#StudyWordKanji}}<div class=\"study-word-kanji\">Other kanji: {{StudyWordKanji}}</div>{{/StudyWordKanji}}",
    "{{#OnReading}}<div class=\"reading reading-full\"><span class=\"field-label\">音読み (on reading)</span>{{OnReading}}</div>{{/OnReading}}",
    "{{#KunReading}}<div class=\"reading reading-full\"><span class=\"field-label\">訓読み (kun reading)</span>{{KunReading}}</div>{{/KunReading}}",
    "<div class=\"media\">{{StrokeOrder}}</div>",
    "<div class=\"meta\">Radicals: {{Radical}}</div>",
    "<div class=\"notes\">{{Notes}}</div>",
    "<div class=\"example\">{{ExampleSentence}}</div>",
    "<div class=\"audio\">{{Audio}}</div>"
  ]
}
