{
  "noteTypeName": "Japanese Kanji Builder Word Note",
  "cardTemplateName": "Word Card",
  "fieldNames": [
    "Word",
    "Reading",
    "ReadingBreakdown",
    "Audio",
    "PitchAccent",
    "Meaning",
    "JLPTLevel",
    "CoverageRole",
    "FocusKanji",
    "CoversReading",
    "KanjiBreakdown",
    "ExampleSentence",
    "Notes"
  ],
  "cssLines": [
    ".card {",
    "  font-family: \"Yu Gothic UI\", \"Hiragino Sans\", \"Noto Sans JP\", sans-serif;",
    "  text-align: center;",
    "  color: #1f2937;",
    "  background: #f8fafc;",
    "  padding: 20px 18px;",
    "}",
    ".word {",
    "  font-size: 42px;",
    "  font-weight: 700;",
    "  margin-bottom: 10px;",
    "}",
    ".word-reading {",
    "  font-size: 24px;",
    "  color: #334155;",
    "  margin-bottom: 8px;",
    "}",
    ".word-reading-breakdown {",
    "  display: inline-block;",
    "  font-size: 16px;",
    "  color: #1e293b;",
    "  background: #ecfeff;",
    "  border: 1px solid #a5f3fc;",
    "  border-radius: 999px;",
    "  padding: 6px 12px;",
    "  margin-bottom: 10px;",
    "}",
    ".word-pitch-accent {",
    "  display: inline-block;",
    "  font-size: 15px;",
    "  color: #3f2f13;",
    "  background: #fff7ed;",
    "  border: 1px solid #fed7aa;",
    "  border-radius: 999px;",
    "  padding: 6px 12px;",
    "  margin: 0 0 10px;",
    "}",
    ".word-pitch-label {",
    "  font-weight: 700;",
    "  color: #7c2d12;",
    "}",
    ".word-meaning {",
    "  font-size: 22px;",
    "  margin-bottom: 8px;",
    "}",
    ".word-level {",
    "  font-size: 16px;",
    "  color: #475569;",
    "  margin-bottom: 6px;",
    "}",
    ".word-coverage {",
    "  display: inline-block;",
    "  font-size: 13px;",
    "  font-weight: 700;",
    "  letter-spacing: 0.03em;",
    "  color: #0f172a;",
    "  background: #e2e8f0;",
    "  border-radius: 999px;",
    "  padding: 5px 10px;",
    "  margin-bottom: 18px;",
    "}",
    ".section {",
    "  text-align: left;",
    "  margin-top: 16px;",
    "}",
    ".section-title {",
    "  font-size: 15px;",
    "  font-weight: 700;",
    "  text-transform: uppercase;",
    "  letter-spacing: 0.04em;",
    "  color: #0f172a;",
    "  margin-bottom: 8px;",
    "}",
    ".study-focus {",
    "  background: #eef2ff;",
    "  border: 1px solid #c7d2fe;",
    "  border-radius: 12px;",
    "  padding: 12px 14px;",
    "}",
    ".focus-line {",
    "  font-size: 15px;",
    "  color: #1e293b;",
    "  line-height: 1.45;",
    "  margin: 4px 0;",
    "}",
    ".focus-label {",
    "  font-weight: 700;",
    "  color: #312e81;",
    "}",
    ".kanji-breakdown-item {",
    "  border: 1px solid #cbd5e1;",
    "  border-radius: 12px;",
    "  padding: 12px;",
    "  margin-bottom: 10px;",
    "  background: #ffffff;",
    "}",
    ".kanji-breakdown-head {",
    "  display: flex;",
    "  justify-content: space-between;",
    "  align-items: baseline;",
    "  gap: 12px;",
    "  margin-bottom: 6px;",
    "}",
    ".kanji-breakdown-title {",
    "  display: flex;",
    "  align-items: center;",
    "  gap: 8px;",
    "  flex-wrap: wrap;",
    "}",
    ".kanji-char {",
    "  font-size: 30px;",
    "  font-weight: 700;",
    "}",
    ".kanji-level-badge {",
    "  display: inline-block;",
    "  font-size: 12px;",
    "  font-weight: 700;",
    "  letter-spacing: 0.03em;",
    "  color: #7c2d12;",
    "  background: #ffedd5;",
    "  border: 1px solid #fdba74;",
    "  border-radius: 999px;",
    "  padding: 3px 8px;",
    "}",
    ".kanji-primary {",
    "  font-size: 18px;",
    "  color: #475569;",
    "}",
    ".kanji-meaning {",
    "  margin-bottom: 6px;",
    "}",
    ".kanji-stroke-order {",
    "  margin: 10px 0 8px;",
    "  padding: 10px;",
    "  border-radius: 10px;",
    "  background: #f8fafc;",
    "  border: 1px solid #e2e8f0;",
    "  text-align: center;",
    "}",
    ".kanji-stroke-order-label {",
    "  font-size: 12px;",
    "  font-weight: 700;",
    "  letter-spacing: 0.04em;",
    "  text-transform: uppercase;",
    "  color: #475569;",
    "  margin-bottom: 6px;",
    "}",
    ".kanji-stroke-order img {",
    "  max-width: 140px;",
    "  width: 100%;",
    "  height: auto;",
    "  display: block;",
    "  margin: 0 auto;",
    "}",
    ".kanji-reading-line {",
    "  font-size: 15px;",
    "  color: #334155;",
    "  margin-bottom: 4px;",
    "}",
    ".kanji-reading-label {",
    "  font-weight: 700;",
    "  color: #0f172a;",
    "}",
    ".notes, .example {",
    "  font-size: 16px;",
    "  line-height: 1.5;",
    "}"
  ],
  "qfmt": "<div class=\"word\">{{Word}}</div>",
  "afmtLines": [
    "{{FrontSide}}",
    "<hr id=\"answer\">",
    "{{#Reading}}<div class=\"word-reading\">{{Reading}}</div>{{/Reading}}",
    "{{#ReadingBreakdown}}<div class=\"word-reading-breakdown\">{{ReadingBreakdown}}</div>{{/ReadingBreakdown}}",
    "{{#Audio}}<div class=\"word-audio\">{{Audio}}</div>{{/Audio}}",
    "{{#PitchAccent}}<div class=\"word-pitch-accent\"><span class=\"word-pitch-label\">Pitch:</span> {{PitchAccent}}</div>{{/PitchAccent}}",
    "{{#Meaning}}<div class=\"word-meaning\">{{Meaning}}</div>{{/Meaning}}",
    "{{#JLPTLevel}}<div class=\"word-level\">{{JLPTLevel}}</div>{{/JLPTLevel}}",
    "{{#CoverageRole}}<div class=\"word-coverage\">{{CoverageRole}}</div>{{/CoverageRole}}",
    "{{#FocusKanji}}<div class=\"section study-focus\"><div class=\"section-title\">Study Focus</div><div class=\"focus-line\"><span class=\"focus-label\">Kanji:</span> {{FocusKanji}}</div>{{#CoversReading}}<div class=\"focus-line\"><span class=\"focus-label\">Reading:</span> {{CoversReading}}</div>{{/CoversReading}}</div>{{/FocusKanji}}",
    "{{#KanjiBreakdown}}<div class=\"section\"><div class=\"section-title\">Kanji Breakdown</div>{{KanjiBreakdown}}</div>{{/KanjiBreakdown}}",
    "{{#ExampleSentence}}<div class=\"section\"><div class=\"section-title\">Example</div><div class=\"example\">{{ExampleSentence}}</div></div>{{/ExampleSentence}}",
    "{{#Notes}}<div class=\"section\"><div class=\"section-title\">Notes</div><div class=\"notes\">{{Notes}}</div></div>{{/Notes}}"
  ]
}
