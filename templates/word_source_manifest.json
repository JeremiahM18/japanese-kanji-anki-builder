  "sourcePurposeRules": {
    "jlpt_level_list": {
      "description": "JLPT-oriented word lists can propose candidate words and weak level hints, but cannot approve cards by themselves.",
      "allowedUse": [
        "candidate-discovery",
        "level-hint"
      ],
      "disallowedUse": [
        "card-approval",
        "reading-verification",
        "meaning-verification",
        "pitch-verification",
        "frequency-sanity"
      ]
    },
    "dictionary": {
      "description": "Dictionary sources can verify exact written, reading, and meaning identity when source-use terms allow the stored citation shape.",
      "allowedUse": [
        "dictionary-verification",
        "reading-verification",
        "meaning-verification"
      ],
      "disallowedUse": [
        "level-truth",
        "frequency-sanity",
        "pitch-verification"
      ]
    },
    "dictionary_priority": {
      "description": "Dictionary priority/commonness markers can support usefulness when attached to exact written-reading identities, but cannot prove JLPT level or approve cards.",
      "allowedUse": [
        "frequency-sanity",
        "usefulness-support"
      ],
      "disallowedUse": [
        "level-truth",
        "card-approval",
        "reading-verification",
        "meaning-verification",
        "pitch-verification"
      ]
    },
    "corpus_frequency": {
      "description": "Corpus or frequency sources can support usefulness and commonness, but cannot prove JLPT level or dictionary identity.",
      "allowedUse": [
        "frequency-sanity",
        "usefulness-support"
      ],
      "disallowedUse": [
        "level-truth",
        "card-approval",
        "reading-verification",
        "meaning-verification",
        "pitch-verification"
      ]
    },
    "pitch_accent": {
      "description": "Pitch sources prove only pitch-accent evidence for an exact written|reading identity.",
      "allowedUse": [
        "pitch-verification"
      ],
      "disallowedUse": [
        "level-truth",
        "candidate-discovery",
        "card-approval",
        "reading-verification",
        "meaning-verification",
        "frequency-sanity"
      ]
    },
    "textbook_word_list": {
      "description": "Japanese-learning textbook word lists can support candidate discovery and stronger learner-level fit when exact permitted surfaces are reviewed.",
      "allowedUse": [
        "candidate-discovery",
        "level-hint",
        "learner-fit-support"
      ],
      "disallowedUse": [
        "card-approval",
        "pitch-verification",
        "frequency-sanity"
      ]
    },
    "community_web_list": {
      "description": "Free public or community web lists are discovery-only unless source-use review approves a narrower governed use.",
      "allowedUse": [
        "candidate-discovery",
        "level-hint"
      ],
      "disallowedUse": [
        "card-approval",
        "reading-verification",
        "meaning-verification",
        "pitch-verification",
        "frequency-sanity"
      ]
    }
  },
